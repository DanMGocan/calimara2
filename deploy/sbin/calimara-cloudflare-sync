#!/usr/bin/env bash
# Keep nginx real-IP config and the UFW web allow-list in sync with Cloudflare's IP ranges.
# Web ports (80/443) only accept Cloudflare; SSH is never touched.
set -euo pipefail
STATE=/etc/calimara/cloudflare-ips.txt
REALIP=/etc/nginx/conf.d/cloudflare-realip.conf
TMP=$(mktemp); trap 'rm -f "$TMP"' EXIT

{ curl -fsS -m 20 https://www.cloudflare.com/ips-v4; echo; curl -fsS -m 20 https://www.cloudflare.com/ips-v6; echo; } \
  | grep -E '^[0-9a-fA-F:.]+/[0-9]+$' | sort -u > "$TMP"
COUNT=$(wc -l < "$TMP")
if [ "$COUNT" -lt 10 ]; then echo "Refusing to apply: only $COUNT Cloudflare ranges fetched" >&2; exit 1; fi

if [ "${1:-}" != "--force" ] && [ -f "$STATE" ] && cmp -s "$TMP" "$STATE"; then
  echo "Cloudflare ranges unchanged ($COUNT)."; exit 0
fi

# nginx: trust CF-Connecting-IP only from Cloudflare
{ echo "# Generated by calimara-cloudflare-sync on $(date -I)"; sed 's/.*/set_real_ip_from &;/' "$TMP"; echo "real_ip_header CF-Connecting-IP;"; } > "$REALIP.new"
mv "$REALIP.new" "$REALIP"
nginx -t -q && systemctl reload nginx

# ufw: replace the cloudflare-tagged rules
ufw allow OpenSSH >/dev/null
for n in $(ufw status numbered | grep '# cloudflare' | sed -E 's/^\[ *([0-9]+)\].*/\1/' | sort -rn); do ufw --force delete "$n" >/dev/null; done
while read -r range; do ufw allow proto tcp from "$range" to any port 80,443 comment cloudflare >/dev/null; done < "$TMP"
ufw delete allow 'Nginx Full' >/dev/null 2>&1 || true
ufw delete allow 'Nginx HTTP' >/dev/null 2>&1 || true
ufw delete allow 'Nginx HTTPS' >/dev/null 2>&1 || true

mkdir -p "$(dirname "$STATE")"; cp "$TMP" "$STATE"
echo "Applied $COUNT Cloudflare ranges to nginx real-IP and UFW."
